# --- Baza danych (Supabase -> Project Settings -> Database -> Connection string, tryb "Transaction" / pooler) ---
DATABASE_URL=postgres://postgres:haslo@localhost:5432/taskhub

# --- Dostęp do aplikacji (jeden użytkownik na start) ---
TASKHUB_OWNER_EMAIL=piotr@example.com
TASKHUB_OWNER_NAME=Piotr
# hasło do logowania w przeglądarce; zmień na długie i losowe
TASKHUB_PASSWORD=zmien-mnie
# sekret do podpisywania ciasteczka sesji (min. 32 znaki losowe)
TASKHUB_SECRET=zmien-mnie-na-losowy-ciag-znakow-min-32

# --- Agent wbudowany (opcjonalny: bez klucza pracę agenta wykonuje Claude/ChatGPT podłączony przez konektor MCP; jeden z dostawców wystarczy, oba = automatyczne przełączanie) ---
AI_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- Opcjonalne ---
# publiczny adres aplikacji (potrzebny do linków w promptach hand-off); Vercel ustawia VERCEL_URL sam
APP_URL=http://localhost:3000
# certyfikat CA bazy (Supabase → Database → SSL Configuration, format PEM; „\n” zamiast nowych linii też działa): pełne sprawdzanie certyfikatu.
# Bez niego połączenie z bazą poza localhost jest szyfrowane (sslmode require), ale certyfikat nie jest sprawdzany
# DATABASE_CA_PEM=
# dodatkowe adresy powrotu OAuth dla klientów MCP (dokładne adresy, po przecinku); Claude, ChatGPT i localhost są dozwolone zawsze
# OAUTH_REDIRECT_ALLOW=
# token GitHuba (fine-grained, tylko contents:read na repozytorium aplikacji) do aktualizacji aplikacji na Maca, gdy repozytorium jest prywatne
# GITHUB_RELEASES_TOKEN=
